---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
const timezone = config.site.timezone;

const MS_PER_DAY = 86_400_000;
const today = new Intl.DateTimeFormat("en-CA", {
  timeZone: timezone,
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
})
  .format(new Date())
  .split("-")
  .map(Number);
const [year, month, day] = today;
const startOfYear = Date.UTC(year, 0, 1);
const daysThisYear = Math.round(
  (Date.UTC(year + 1, 0, 1) - startOfYear) / MS_PER_DAY
);
const dayOfYear =
  Math.round((Date.UTC(year, month - 1, day) - startOfYear) / MS_PER_DAY) + 1;
const daysLeft = daysThisYear - dayOfYear;
const yearPercent = ((dayOfYear / daysThisYear) * 100).toFixed(1);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="sr-only">duanyzhi 的博客</h1>
      <div id="year-progress" data-timezone={timezone}>
        <p class="text-lg sm:text-xl">
          <span class="text-accent font-semibold" data-year>{year}</span>
          年已经过了
          <span class="text-accent font-semibold" data-day>{dayOfYear}</span>
          天，还剩 <span class="text-accent font-semibold" data-left
            >{daysLeft}</span
          > 天
        </p>
        <div class="bg-muted mt-3 h-2 w-full overflow-hidden rounded-full">
          <div
            class="bg-accent h-full rounded-full transition-all duration-700"
            style={`width: ${yearPercent}%`}
            data-bar
          >
          </div>
        </div>
        <p class="text-muted-foreground mt-2 text-right text-sm">
          <span data-percent>{yearPercent}</span>%
        </p>
      </div>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="mt-4 inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const MS_PER_DAY = 86_400_000;

  function getYearProgress(timezone: string) {
    const parts = new Intl.DateTimeFormat("en-CA", {
      timeZone: timezone,
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    })
      .format(new Date())
      .split("-")
      .map(Number);
    const [year, month, day] = parts;
    const startOfYear = Date.UTC(year, 0, 1);
    const daysThisYear = Math.round(
      (Date.UTC(year + 1, 0, 1) - startOfYear) / MS_PER_DAY
    );
    const dayOfYear =
      Math.round((Date.UTC(year, month - 1, day) - startOfYear) / MS_PER_DAY) +
      1;
    return {
      year,
      dayOfYear,
      daysLeft: daysThisYear - dayOfYear,
      percent: ((dayOfYear / daysThisYear) * 100).toFixed(1),
    };
  }

  /** 算出距离时区里下一个零点还有多少毫秒。 */
  function getMsUntilMidnight(timezone: string) {
    const [hour, minute, second] = new Intl.DateTimeFormat("en-CA", {
      timeZone: timezone,
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hourCycle: "h23",
    })
      .format(new Date())
      .split(":")
      .map(Number);
    const elapsed = (hour * 3600 + minute * 60 + second) * 1000;
    return MS_PER_DAY - elapsed + 1000;
  }

  let midnightTimer: number | undefined;

  /** 页面一直开着也能跨天刷新，不用重新加载。 */
  function scheduleMidnightRefresh(timezone: string) {
    window.clearTimeout(midnightTimer);
    midnightTimer = window.setTimeout(
      () => renderYearProgress(),
      getMsUntilMidnight(timezone)
    );
  }

  function renderYearProgress() {
    const root = document.querySelector<HTMLElement>("#year-progress");
    if (!root) return;
    const timezone = root.dataset.timezone ?? "UTC";
    const { year, dayOfYear, daysLeft, percent } = getYearProgress(timezone);
    const fill = (key: string, value: string | number) => {
      const el = root.querySelector<HTMLElement>(`[data-${key}]`);
      if (el) el.textContent = String(value);
    };
    fill("year", year);
    fill("day", dayOfYear);
    fill("left", daysLeft);
    fill("percent", percent);
    const bar = root.querySelector<HTMLElement>("[data-bar]");
    if (bar) bar.style.width = `${percent}%`;
    scheduleMidnightRefresh(timezone);
  }

  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      try {
        sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
      } catch {
        // 浏览器禁用存储时忽略，别影响天数渲染。
      }
    }
    renderYearProgress();
  });

  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) renderYearProgress();
  });
</script>
